{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Artboard width. Origin is top-left, y points down."
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Artboard height. Origin is top-left, y points down."
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "description": "Child nodes. Array order is z-order: the first child is drawn first (bottom)."
    }
  },
  "required": [
    "version",
    "width",
    "height",
    "children"
  ],
  "additionalProperties": false,
  "title": "Cumulus asset v1",
  "$defs": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "group"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Node name, unique in the file. Shown in the editor and targeted by animations."
            },
            "transform": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "rotation": {
                  "type": "number",
                  "description": "Degrees, clockwise."
                },
                "scaleX": {
                  "type": "number"
                },
                "scaleY": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              },
              "description": "Child nodes. Array order is z-order: the first child is drawn first (bottom)."
            }
          },
          "required": [
            "type",
            "id",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rect"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Node name, unique in the file. Shown in the editor and targeted by animations."
            },
            "transform": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "rotation": {
                  "type": "number",
                  "description": "Degrees, clockwise."
                },
                "scaleX": {
                  "type": "number"
                },
                "scaleY": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "stroke": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "color",
                "width"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "id",
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ellipse"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Node name, unique in the file. Shown in the editor and targeted by animations."
            },
            "transform": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "rotation": {
                  "type": "number",
                  "description": "Degrees, clockwise."
                },
                "scaleX": {
                  "type": "number"
                },
                "scaleY": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "rx": {
              "type": "number",
              "minimum": 0
            },
            "ry": {
              "type": "number",
              "minimum": 0
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "stroke": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "color",
                "width"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "id",
            "cx",
            "cy",
            "rx",
            "ry"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "path"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Node name, unique in the file. Shown in the editor and targeted by animations."
            },
            "transform": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "rotation": {
                  "type": "number",
                  "description": "Degrees, clockwise."
                },
                "scaleX": {
                  "type": "number"
                },
                "scaleY": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "closed": {
              "type": "boolean"
            },
            "points": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "in": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false,
                    "description": "Handle offset relative to the point. Missing means zero (a corner)."
                  },
                  "out": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false,
                    "description": "Handle offset relative to the point. Missing means zero (a corner)."
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "stroke": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "color",
                "width"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "id",
            "closed",
            "points"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
